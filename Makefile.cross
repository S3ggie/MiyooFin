# -------------------------------------------------------------------
# Makefile.cross — Cross-compile MiyooFin for Miyoo Mini Plus
# Used inside the miyoofin-toolchain Docker container.
# Variables come from the Docker environment or can be overridden.
# -------------------------------------------------------------------

CROSS_PREFIX ?= arm-linux-gnueabihf-
SYSROOT      ?= /usr/arm-linux-gnueabihf

CXX := $(CROSS_PREFIX)g++
CC  := $(CROSS_PREFIX)gcc
AR  := $(CROSS_PREFIX)ar

PERF_TELEMETRY ?= 1
CXXFLAGS := -std=c++17 -Wall -Wextra -Wpedantic -g -O2 -DMIYOOFIN_ENABLE_PERF_TELEMETRY=$(PERF_TELEMETRY)
INCLUDES := -I. -Iinclude -I$(SYSROOT)/include/SDL2 -D_GNU_SOURCE=1 -D_REENTRANT
SQLITE_DIR := vendor/sqlite
SQLITE_SRC := $(SQLITE_DIR)/sqlite3.c
SQLITE_DEFINES := -DSQLITE_THREADSAFE=2 -DSQLITE_DEFAULT_MEMSTATUS=0 \
                  -DSQLITE_DQS=0 -DSQLITE_TRUSTED_SCHEMA=0 \
                  -DSQLITE_OMIT_LOAD_EXTENSION
SQLITE_CFLAGS := -Os $(SQLITE_DEFINES)
SQLITE_ARM_OBJ := output/build-arm/sqlite/sqlite3.o

# Source files
TELEMETRY_SRCS :=
ifeq ($(PERF_TELEMETRY),1)
TELEMETRY_SRCS := \
    src/diagnostics/TelemetryConfig.cpp \
    src/diagnostics/PerformanceTelemetry.cpp \
    src/diagnostics/MftFormat.cpp \
    src/diagnostics/TelemetryWriter.cpp \
    src/diagnostics/LinuxProcessMetrics.cpp
endif
SRCS := \
    src/main.cpp \
    src/app/App.cpp \
    src/catalog/CatalogDb.cpp \
    src/catalog/MediaItemSql.cpp \
    src/app/UiDiagnostics.cpp \
    src/app/ScreenStack.cpp \
    src/data/MockData.cpp \
    src/input/InputManager.cpp \
    src/image/stb_image_impl.cpp \
    src/image/ImageDecoder.cpp \
    src/net/ArtworkUrl.cpp \
    src/net/HttpClient.cpp \
    src/net/JellyfinApi.cpp \
    src/net/JellyfinApiJson.cpp \
    src/net/JellyfinApiAuth.cpp \
    src/net/JellyfinApiLibrary.cpp \
    src/net/JellyfinApiHierarchy.cpp \
    src/net/JellyfinApiPlayback.cpp \
    src/net/JellyfinApiDownload.cpp \
    src/net/Session.cpp \
    src/net/DeviceIdentity.cpp \
    src/cache/ImageCache.cpp \
    src/cache/LibraryCache.cpp \
    src/cache/SyncState.cpp \
    src/cache/OfflineCatalog.cpp \
    src/cache/OfflineLibraryProjection.cpp \
    src/download/DownloadStore.cpp \
    src/download/DownloadManager.cpp \
    src/download/DownloadManagerPlanning.cpp \
    src/download/DownloadManagerReconcileWorker.cpp \
    src/download/DownloadManagerTransfer.cpp \
    src/download/DownloadReconcile.cpp \
    src/download/DownloadSupport.cpp \
    src/download/HlsPlaylist.cpp \
    src/ui/BitmapFont.cpp \
    src/ui/OnScreenKeyboard.cpp \
    src/ui/HomeSettingsModel.cpp \
    src/ui/HomeTabs.cpp \
    src/ui/HomeArtworkPlan.cpp \
    src/ui/screens/HomeScreen.cpp \
    src/ui/screens/HomeScreenNavigation.cpp \
    src/ui/screens/HomeScreenRefresh.cpp \
    src/ui/screens/HomeScreenSync.cpp \
    src/ui/screens/HomeScreenHierarchy.cpp \
    src/ui/screens/HomeScreenArtwork.cpp \
    src/ui/screens/HomeScreenSettings.cpp \
    src/ui/screens/HomeScreenDownloads.cpp \
    src/ui/screens/HomeScreenRender.cpp \
    src/ui/screens/StartupScreen.cpp \
    src/ui/screens/ServerEntryScreen.cpp \
    src/ui/screens/ConnectScreen.cpp \
    src/ui/screens/LoginScreen.cpp \
    src/ui/screens/AuthCheckScreen.cpp \
    src/ui/screens/InputDiagnosticsScreen.cpp \
    src/ui/screens/SeriesScreen.cpp \
    src/ui/screens/EpisodeBrowserScreen.cpp \
    src/ui/screens/EpisodeBrowserRender.cpp \
    src/ui/screens/EpisodeBrowserArtwork.cpp \
    src/ui/screens/EpisodeBrowserPlayback.cpp \
    src/ui/screens/EpisodeBrowserDownloads.cpp \
    src/ui/screens/MovieDetailsScreen.cpp \
    src/playback/OfflinePlaybackJournal.cpp \
    src/playback/PlaybackRequest.cpp \
    $(TELEMETRY_SRCS)

OBJS      := $(SRCS:src/%.cpp=output/build-arm/%.o)
OBJS      += $(SQLITE_ARM_OBJ)
DEPS      := $(OBJS:.o=.d)
.DEFAULT_GOAL := all
-include $(DEPS)
TARGET    := output/build-arm/miyoofin
OUT_DIRS  := output/build-arm/app output/build-arm/data output/build-arm/input \
             output/build-arm/image output/build-arm/net output/build-arm/cache \
             output/build-arm/download output/build-arm/catalog \
             output/build-arm/diagnostics output/build-arm/sqlite \
             output/build-arm/ui/screens output/build-arm/playback

.PHONY: all bridge reporter
all: $(TARGET)
	@echo "=== ARM build complete: $(TARGET) ==="
	@file $(TARGET)
	@$(CROSS_PREFIX)readelf -h $(TARGET) | grep -E 'Class|Machine|Flags'

$(TARGET): $(OBJS) | output/build-arm
	$(CXX) $(CXXFLAGS) -L$(SYSROOT)/lib -L/opt/miyoo/lib -Wl,-rpath-link,/opt/miyoo/lib -Wl,--allow-shlib-undefined -o $@ $^ -lSDL2 -lcurl -lpthread
	@echo "  [LINK] $@"

output/build-arm/%.o: src/%.cpp | $(OUT_DIRS)
	$(CXX) $(CXXFLAGS) -MMD -MP $(INCLUDES) -c -o $@ $<
	@echo "  [CC]   $@"

$(SQLITE_ARM_OBJ): $(SQLITE_SRC) $(SQLITE_DIR)/sqlite3.h | output/build-arm/sqlite
	$(CC) $(SQLITE_CFLAGS) -MMD -MP -I$(SQLITE_DIR) -c -o $@ $<
	@echo "  [CC]   $@"

$(OUT_DIRS):
	@mkdir -p $@

output/build-arm:
	@mkdir -p $@

# -------------------------------------------------------------------
# HTTPS bridge (standalone helper — NOT linked into MiyooFin)
# -------------------------------------------------------------------
BRIDGE_SRC := tools/https_bridge.cpp
BRIDGE_ARM := output/build-arm/miyoofin-https-bridge

bridge: $(BRIDGE_ARM)

$(BRIDGE_ARM): $(BRIDGE_SRC) tools/https_bridge_parse.hpp tools/playback_route.hpp | output/build-arm
	$(CXX) $(CXXFLAGS) -Itools -L$(SYSROOT)/lib -L/opt/miyoo/lib -Wl,-rpath-link,/opt/miyoo/lib -Wl,--allow-shlib-undefined -o $@ $< -lcurl
	@echo "  [LINK] $@"

# -------------------------------------------------------------------
# wait_menu_release (tiny evdev helper — detects MENU button release)
# -------------------------------------------------------------------
WAIT_RELEASE_SRC  := tools/wait_menu_release.c
WAIT_RELEASE_ARM  := output/build-arm/wait_menu_release

$(WAIT_RELEASE_ARM): $(WAIT_RELEASE_SRC) | output/build-arm
	$(CC) -Wall -Wextra -pedantic -O2 -o $@ $<
	@echo "  [LINK] $@"

.PHONY: wait-release
wait-release: $(WAIT_RELEASE_ARM)

# -------------------------------------------------------------------
# playback reporter (standalone Jellyfin playback reporting helper)
# -------------------------------------------------------------------
REPORTER_SRC     := tools/playback_reporter.cpp
REPORTER_ARM     := output/build-arm/miyoofin-playback-reporter

reporter: $(REPORTER_ARM)

$(REPORTER_ARM): $(REPORTER_SRC) tools/playback_clock_parser.hpp tools/playback_route.hpp | output/build-arm
	$(CXX) $(CXXFLAGS) -Itools -Iinclude -L$(SYSROOT)/lib -L/opt/miyoo/lib -Wl,-rpath-link,/opt/miyoo/lib -Wl,--allow-shlib-undefined -o $@ $< -lcurl
	@echo "  [LINK] $@"

.PHONY: clean
clean:
	@rm -rf output/build-arm
